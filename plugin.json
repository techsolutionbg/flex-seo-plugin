{
  "id": "flex/seo",
  "name": "Flex SEO",
  "version": "0.2.0",
  "description": "SEO заглавия, meta описания, Open Graph, структурирани данни, sitemap.xml, robots.txt и проверка на съдържанието.",
  "minimum_platform_version": "0.1.59",
  "entrypoint": "Flex\\Seo\\SeoPlugin",
  "autoload": {
    "Flex\\Seo\\": "src/"
  },
  "permissions": [
    "admin.ui",
    "events.listen",
    "routes.admin",
    "routes.public",
    "frontend.assets"
  ],
  "frontend": {
    "scripts": [
      "assets/admin.js"
    ],
    "styles": [
      "assets/admin.css"
    ]
  },
  "metadata": {
    "status": "stable",
    "storage": "database",
    "optional": [
      "flex/commerce"
    ]
  }
}
